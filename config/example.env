# Copy to .local/config.env and replace resource paths. This is trusted shell input.
PYTHON=python3
CHJ_CSV=/path/to/CHJ_with_bibliography.csv
SHC_CSV=/path/to/SHC_with_bibliography.csv
BCCWJ_CSV=/path/to/PM_with_bibliography.csv
# Enriched Iwanami JSONL with sense_definition, @senseid and optional WLSP/WordNet fields.
IWANAMI_TARGETS=/path/to/iwanami_corpus_with_wlsp_polysemous_definitions_lemma.jsonl
IWANAMI_FULL=/path/to/iwanami_corpus.jsonl
WORDNET_DB=/path/to/wnjpn.db
PN_DICT=/path/to/pn.csv.m3.120408.trim
PROMPT_TEMPLATE=/path/to/private_historical_prompt_template.txt
# Hugging Face cache layout: refs/main, snapshots/<revision>, blobs/.
QWEN_CACHE=/path/to/models--Qwen--Qwen3-8B
EMBEDDING_MODEL=sbintuitions/sarashina-embedding-v2-1b
BERT_MODEL=tohoku-nlp/bert-base-japanese-v3
BERT_CHECKPOINT=/path/to/wordnet_wsd_bert/best_model
METAPHOR_PACKAGE=/path/to/metaphor/release_package
METAPHOR_CHECKPOINT=/path/to/fold_4_best/model.pt
BUNRUI_WORD=/path/to/bunnrui_data.json
BUNRUI_DATABASE=/path/to/bunnrui_database.json
JASEM_ROOT=/path/to/JaSemChange_full
JASEM_ANNOTATED=/path/to/JaSemChange/annotated_data
# These historical score tables are tab-separated, despite their .csv suffix.
JASEM_CHJ_SCORES=/path/to/jasemchange_chj_bccwj.csv
JASEM_SHC_SCORES=/path/to/jasemchange_shc_bccwj.csv
GPU_IDS=0
GPU_WORKERS=1
BATCH_SIZE=64
MAX_TOKENS=16384
GPU_MEMORY_UTILIZATION=0.92
# Set to 1 only when IWANAMI_TARGETS already contains the original WordNet alignment.
DICTIONARY_ALREADY_ALIGNED=0
# Optional: reuse existing PRIVATE predictions for CPU-only result verification.
# EXISTING_GENERATED=/path/to/final_150_entry_predictions
# EXISTING_BASELINES=/path/to/retrieval_baseline_predictions
# EXISTING_JASEM_GENERATED=/path/to/jasemchange_predictions
# Required only for the historical metric-table path in --mode paper:
# HISTORICAL_METRICS='["/path/to/first/metrics_by_decade.csv", "/path/to/second/metrics_by_decade.csv"]'
# Maintainer-only annotation export inputs:
# ANNOTATOR_MAP=/path/to/private_annotator_mapping.json
